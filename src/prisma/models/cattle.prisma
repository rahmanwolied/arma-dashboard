enum CattleClass {
    GOLD
    SILVER
    PLATINUM

    @@map("CattleClass")
}

enum HealthStatus {
    HEALTHY
    SICK
    DEAD
}

enum Gender {
    MALE
    FEMALE
}

model Cattle {
    id           String  @id @default(cuid())
    cattleNumber Int
    name         String?

    // Gender
    gender Gender @default(FEMALE)

    // Purchase Details
    cattlePurchase   CattlePurchase @relation(fields: [cattlePurchaseId], references: [id], onDelete: Cascade)
    cattlePurchaseId String         @unique

    // Sale Details
    cattleSale   CattleSale? @relation(fields: [cattleSaleId], references: [id], onDelete: Cascade)
    cattleSaleId String?      @unique

    cattleClass CattleClass @default(SILVER)

    imageUrl String?

    // Status
    isQuarantined Boolean @default(false)

    // For cattle
    isPregnant    Boolean @default(false) // for cattle
    isLactating   Boolean @default(false) // for cattle
    isInseminated Boolean @default(false) // for cattle

    // Health
    healthStatus HealthStatus @default(HEALTHY)
    healthNotes  String?
    isVaccinated Boolean      @default(false) // for cattle

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relationships
    transactionItems TransactionItem[]
}

model CattlePurchase {
    id String @id @default(cuid())

    purchaseDate       DateTime @default(now())
    purchasePricePerKg Int

    liveWeight     Int // kg
    meatPercentage Int // %
    fatPercentage  Int // %

    purchaseLocation String

    createdAt DateTime @default(now())
    Cattle    Cattle
    cattleId String
}

model CattleSale {
    id String @id @default(cuid())

    saleDate       DateTime @default(now())
    salePricePerKg Int
    liveWeight     Int // kg
    meatPercentage Int // %
    fatPercentage  Int // %

    customerId String
    customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    Cattle    Cattle[]
}
